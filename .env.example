# Netlify project to publish to (created for you: lanka-daily-digest)
NETLIFY_SITE_ID=505d6187-d364-4f5e-8404-49e64e0dcd87

# Deploy auth - either run `npx netlify login` once (recommended), or paste a
# personal access token from https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# Optional: Claude writes the summaries and picks categories when this is set.
# Leave empty to use the free offline keyword engine.
ANTHROPIC_API_KEY=

# Optional overrides
# SITE_TITLE=Lanka Daily Digest
# CLAUDE_MODEL=claude-opus-5-5
